{
  "checkpoint_dir": "../outputs",
  "experiment_name": "FGA-MIL_TCGA-BRCA",
  "label_map": {"negative": 0, "positive": 1},
  "group_column": "patient_id",
  "bag_loss": "focal_loss",
  "focal_loss_gamma": 2.0,
  "label_smoothing": 0.1,
  "positive_weight_multiplier": 1.0,
  "batch_size": 1,
  "num_workers": 0,
  "epochs": 100,
  "seed": 42,
  "n_outer_folds": 5,
  "test_split_ratio": 0.2,
  "val_split_ratio": 0.1,
  "early_stopping_patience": 20,
  "min_epochs": 15,
  "warmup_epochs": 5,
  "use_weighted_sampler": true,
  "use_cache": true,
  "hidden_dim": 256,
  "num_agents": 16,
  "num_heads": 8,
  "num_archetypes": 8,
  "num_agent_blocks": 1,
  "ff_mult": 2,
  "use_gated_pooling": true,
  "use_inter_class_margin": true,
  "inter_class_margin": 1.0,
  "inter_class_margin_weight": 0.05,
  "archetype_diversity_loss_weight": 0.05,
  "dropout_rate": 0.1,
  "flow_loss_weight": 0.0,
  "use_class_conditional_flow": false,
  "ema_decay": 0.999,
  "optimizer": "muon_adam",
  "muon_lr": 0.002,
  "muon_momentum": 0.9,
  "adam_lr": 0.0001,
  "weight_decay": 0.02,
  "use_amp": true
}
